<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="formfieldsparams">
        <fieldset name="fieldparams" label="PLG_ALFA_FORM_FIELDS_TEL_PARAMS_TAB">
            <!-- The countries only (places with no parent), by their ISO 3166-1 code: a place inside a country carries
                 no country code of its own (2.2.1). -->
            <field
                layout="joomla.form.field.list-fancy-select"
                name="default_region"
                type="sql"
                query="SELECT code2, name FROM #__alfa_places WHERE COALESCE(parent_id, 0) = 0 ORDER BY name ASC"
                key_field="code2"
                value_field="name"
                default="GR"
                label="PLG_ALFA_FORM_FIELDS_TEL_DEFAULT_REGION_LABEL">
            </field>

            <field
                layout="joomla.form.field.list-fancy-select"
                name="allowed_regions"
                type="sql"
                query="SELECT code2, name FROM #__alfa_places WHERE COALESCE(parent_id, 0) = 0 ORDER BY name ASC"
                key_field="code2"
                value_field="name"
                default=""
                label="PLG_ALFA_FORM_FIELDS_TEL_ALLOWED_REGIONS_LABEL"
                hint="PLG_ALFA_FORM_FIELDS_TEL_SELECT_COUNTRY"
                description="PLG_ALFA_FORM_FIELDS_TEL_ALLOWED_REGIONS_DESC"
                multiple="true" />

            <field name="require_mobile" type="radio" default="0"
                   label="PLG_ALFA_FORM_FIELDS_TEL_REQUIRE_MOBILE_LABEL">
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <!-- `validate` is intentionally NOT set here. It is applied in code:
                 plugins/alfa-form-fields/tel/src/Extension/Tel.php (prepareDom fallback).
                 To override per field, add as a visible list with lowercase values. -->

            <!-- Read by FormfieldModel.php to pick the MySQL column type. Do not remove.
                 E.164 is max 15 digits + '+' = 16 chars; varchar(20) gives safe headroom. -->
            <field name="sql_type" type="hidden" default="varchar(20)"/>

        </fieldset>
    </fields>
</form>