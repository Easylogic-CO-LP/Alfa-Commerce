<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_alfa</name>
    <creationDate>2024-05-10</creationDate>
    <copyright>(C) 2024-2026 Easylogic CO LP / Agamemnon Fakas. All rights reserved.</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE</license>
    <author>Agamemnon Fakas</author>
    <authorEmail>info@easylogic.gr</authorEmail>
    <authorUrl>https://easylogic.gr</authorUrl>
    <!-- 2.0.0 is the first stable release and the schema baseline. script.php's preflight()
         reads the installed alfa.xml before any file is copied and REFUSES the install over
         anything older than 2.0.0: the 1.x betas have no schema baseline to update from.
         From 2.0.0 on Joomla tracks the schema through <update> below: an install records
         the newest file in sql/updates/mysql, an update runs every file newer than the
         recorded version. A schema change therefore goes into install.mysql.utf8.sql (fresh
         installs) AND into a new sql/updates/mysql/<version>.sql (installed sites). -->
    <version>2.1.1</version>
    <description>The smartest,fastest and easiest ecommerce solution for companies developed with love by Easylogic.</description>
    <namespace path="src">Alfa\Component\Alfa</namespace>

    <scriptfile>script.php</scriptfile>

    <install> <!-- Runs on install -->
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <!-- No uninstall SQL, on purpose: uninstalling keeps every Alfa table and its data, and
         installing the same schema again reconnects it (script.php preflight reads the schema
         version kept in #__alfa_meta). Joomla would also run an uninstall SQL as the rollback
         of a failed install, over tables that may hold a shop's data. Removing the data is an
         explicit administrator action, never the uninstaller's. -->
    <update> <!-- Runs on update: every sql/updates/mysql/<version>.sql newer than the recorded schema -->
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <api>
		<files folder="api">
			<folder>src</folder>
		</files>
	</api>

    <files folder="site">
        <folder>src</folder>
        <folder>forms</folder>
	<folder>layouts</folder>
        <folder>tmpl</folder>
    </files>
    <media destination="com_alfa" folder="media">
        <folder>images</folder>
        <folder>css</folder>
        <folder>js</folder>
        <filename>joomla.asset.json</filename>
    </media>
    <!-- The package carries en-GB only. Every other language is a separate language pack that
         installs its files beside these en-GB files. -->
    <languages folder="site/languages">
			<language tag="en-GB">en-GB/com_alfa.ini</language>
    </languages>
    <administration>
        <menu>COM_ALFA</menu>
        <!--
            No <submenu> here on purpose. The admin menu is declared in menu.xml + built by
            MenuBuilder (core items + plugin onAlfaBuildMenu entries), and MenuInjector places
            it into Joomla's native sidebar on every page, so it is dynamic, icon-rich and
            plugin-extensible instead of a fixed set of DB menu rows.
        -->
        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <!-- The admin sidebar is built from this, not from <submenu> rows. -->
            <filename>menu.xml</filename>
            <filename>LICENSE</filename>
            <folder>files</folder>
            <folder>forms</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>services</folder>
            <folder>layouts</folder>
            <folder>sql</folder>
            <!-- Guided tours: the JSON files ARE the source of truth (TourSeeder
                 deletes any com_alfa tour it cannot find a file for), and core
                 loads each tour's INI from the component folder. -->
            <folder>tours</folder>
            <folder>language</folder>
        </files>
        <languages folder="administrator/languages">

			<language tag="en-GB">en-GB/com_alfa.ini</language>
			<language tag="en-GB">en-GB/com_alfa.sys.ini</language>
        </languages>
    </administration>
<!--     <config>
        <fields name="params">
            <fieldset name="component">
                <field name="save_history" default="0" />
            </fieldset>
        </fields>
    </config> -->
    <plugins>
		<plugin group="webservices" plugin="alfa"/>

        <plugin group="alfa-payments" plugin="standard"/>

        <plugin group="alfa-shipments" plugin="standard"/>

        <plugin group="alfa-form-fields" plugin="tel"/>
        <plugin group="alfa-form-fields" plugin="text"/>
        <plugin group="alfa-form-fields" plugin="textarea"/>
        <plugin group="alfa-form-fields" plugin="choice"/>
        <plugin group="alfa-form-fields" plugin="country"/>

        <plugin group="alfa-item-fields" plugin="choice"/>

        <!--
            NO SEARCH ENGINE IS BUNDLED, deliberately.

            Alfa Commerce always searches the catalogue: the component ships a complete
            search over the live product tables, which needs no index, no rebuild and no
            configuration. What it does not ship is a search ENGINE.

            An engine is a separately licensed extension. plg_alfa-search_indexed prepares a
            denormalised copy of the catalogue and searches that instead: faster on a
            large catalogue, and able to search descriptive text the live search does not
            cover. It is installed by the merchant, not by this manifest.

            What core DOES ship is the contract every engine implements:
            SearchEngineInterface, SearchIndexerInterface, SearchProviderInterface,
            SearchDocument, SearchScope,
            the registry and the rebuild orchestration, so an engine is an
            implementation of a published API rather than a patch to the component.
        -->

        <plugin  group="system" plugin="alfasync"/>

        <!-- Prepares the list prices of new combinations of customer groups (a scheduled task). -->
        <plugin group="task" plugin="alfapricesets"/>

        <plugin group="console" plugin="alfainventory"/>

    </plugins>

    <modules>
        <module module="mod_alfa_cart" />
		<module module="mod_alfa_search" />
        <module module="mod_alfa_filters" />
        <module module="mod_alfa_items" />
        <module module="mod_easy_articles" />
	</modules>

    <libraries>
        <library folder="lib_libphonenumber" libraryname="libphonenumber"/>
        <library folder="lib_giggsey_locale" libraryname="giggsey/locale"/>
    </libraries>

    <updateservers>
        <server type="extension" priority="1" name="Alfa Commerce Update Server">https://cdn.alfacommerce.gr/com_alfa/update.xml</server>
    </updateservers>
</extension>
