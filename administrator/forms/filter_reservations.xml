<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field">
    <fields name="filter">
        <field
                name="search"
                type="text"
                inputmode="search"
                label="COM_ALFA_FILTER_SEARCH_LABEL"
                description="COM_ALFA_RESERVATION_FILTER_SEARCH_DESC"
                hint="COM_ALFA_RESERVATIONS_SEARCH_PLACEHOLDER"
        />

        <field
                name="state"
                type="list"
                label="JSTATUS"
                onchange="this.form.submit();"
        >
            <option value="">COM_ALFA_RESERVATION_FILTER_STATE</option>
            <option value="active">COM_ALFA_RESERVATION_STATE_ACTIVE</option>
            <option value="partial">COM_ALFA_RESERVATION_STATE_PARTIAL</option>
            <option value="fulfilled">COM_ALFA_RESERVATION_STATE_FULFILLED</option>
            <option value="released">COM_ALFA_RESERVATION_STATE_RELEASED</option>
            <option value="expired">COM_ALFA_RESERVATION_STATE_EXPIRED</option>
            <option value="cancelled">COM_ALFA_RESERVATION_STATE_CANCELLED</option>
        </field>

        <field name="date_range" type="daterange"
               label="COM_ALFA_FILTER_DATE_RANGE"
               layout="joomla.form.field.list-fancy-select"
               onchange="this.form.submit();" />

        <field name="date_start" type="calendar" default="" showtime="true"
               translateformat="true" filter="raw"
               label="COM_ALFA_FILTER_DATE_START" />

        <field name="date_end" type="calendar" default="" showtime="true"
               translateformat="true" filter="raw"
               label="COM_ALFA_FILTER_DATE_END" />
    </fields>

    <fields name="list">
        <field
                name="fullordering"
                type="list"
                label="JGLOBAL_SORT_BY"
                onchange="this.form.submit();"
                default="a.id DESC"
                validate="options"
        >
            <option value="a.id DESC">COM_ALFA_INVENTORY_SORT_NEWEST</option>
            <option value="a.id ASC">COM_ALFA_INVENTORY_SORT_OLDEST</option>
            <option value="a.expires_at ASC">COM_ALFA_RESERVATION_SORT_EXPIRY</option>
        </field>

        <field
                name="limit"
                type="limitbox"
                label="JGLOBAL_LIST_LIMIT"
                default="25"
                onchange="this.form.submit();"
        />
    </fields>
</form>
