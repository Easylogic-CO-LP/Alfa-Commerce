<?xml version="1.0" encoding="UTF-8"?>
<!--
    Shipment form: complete coverage of #__alfa_order_shipments columns.

    Used for BOTH:
    1. Popup add/edit form (getShipmentForm -> edit_shipment.php)
    2. List column definitions (edit_shipments.php subform)

    Field groups:
      ITEMS:    items (virtual, assign products to shipment)
      CORE:     id_shipment_method, status, shipping_cost_tax_incl/excl,
                shipping_tax_rate
      CARRIER:  tracking_number, carrier_name, weight
      DATES:    added, shipped (readonly), delivered (readonly)
      HIDDEN:   id, id_order, id_currency, id_employee,
                shipment_method_name, id_order_invoice

    The `status` list field has NO static options; always injected by
    OrderModel::getShipmentForm() from ShipmentLedger constants.

    The `shipped` and `delivered` fields are readonly calendar fields.
    They are set programmatically by the builder (->shipped(), ->delivered())
    but visible in the edit form and list for admin reference.

    DB: #__alfa_order_shipments
-->
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field" addruleprefix="Alfa\Component\Alfa\Administrator\Rule">
    <fieldset name="shipment">

        <!-- CORE FIELDS                                             -->

        <!-- Shipment method (dropdown from shipments table) -->
        <field
                name="id_shipment_method" type="model"
                model="shipments"
                column_value="id"
                column_text="name"
                input_type="list"
                required="true"
                multiple="false"
                label="COM_ALFA_SHIPMENT_METHOD"
                description="COM_ALFA_SHIPMENT_METHOD_DESC"
                layout="joomla.form.field.list-fancy-select"
        />

        <!-- Shipment status: options injected by OrderModel::getShipmentForm() -->
        <field
                name="status"
                type="list"
                label="COM_ALFA_STATUS"
                description="COM_ALFA_SHIPMENT_STATUS_DESC"
                default="pending"
                required="true"
        />

        <!-- ITEMS - virtual field (not a DB column)                 -->

        <!-- Order lines carried by this parcel.
             assign_mode="shipment" counts UNITS through the shipment-items
             join table, so a line stays on offer while any of it is still
             unshipped and can go on a second parcel too. The "xN" shown is
             what is AVAILABLE, not what was ordered.
             Processed by saveOrderShipment() -> assignItemsToShipment() -->
        <field
                name="items" type="orderItems"
                input_id="id_order"
                entity_id="id"
                assign_mode="shipment"
                show_quantity="true"
                show_sku="false"
                multiple="true"
                label="COM_ALFA_ITEMS"
                description=""
                layout="joomla.form.field.list-fancy-select"
                required="false"
        />

        <!-- Shipping cost tax included. Both costs are amounts of the order's
             money exactly as typed: each input steps by the order's smallest
             unit, and one finer than the order's currency is refused, never
             rounded. -->
        <field
                name="shipping_cost_tax_incl"
                type="orderMoney"
                label="COM_ALFA_COST_TAX_INCL"
                description=""
                min="0"
                default="0"
                required="false"
                validate="orderMoney"
                sign="nonnegative"
        />

        <!-- Shipping cost tax excluded. Left empty, the charge is untaxed:
             the net is the cost including tax. -->
        <field
                name="shipping_cost_tax_excl"
                type="orderMoney"
                label="COM_ALFA_COST_TAX_EXCL"
                description="COM_ALFA_COST_TAX_EXCL_DESC"
                min="0"
                required="false"
                validate="orderMoney"
                sign="nonnegative"
        />

        <!-- The VAT rate the charge was taxed at, frozen with the amounts. A
             taxed charge (cost including tax above the cost excluding it)
             states it; the shipment is refused without it. -->
        <field
                name="shipping_tax_rate"
                type="number"
                label="COM_ALFA_SHIPPING_TAX_RATE"
                description="COM_ALFA_SHIPPING_TAX_RATE_DESC"
                step="0.001"
                min="0"
                default="0"
                required="false"
        />

        <!-- CARRIER FIELDS                                          -->

        <!-- Tracking number from carrier -->
        <field
                name="tracking_number"
                type="text"
                default=""
                label="COM_ALFA_TRACKING_NUMBER"
                description="COM_ALFA_TRACKING_NUMBER_DESC"
        />

        <!-- Carrier name (the courier company handling the parcel) -->
        <field
                name="carrier_name"
                type="text"
                default=""
                label="COM_ALFA_CARRIER_NAME"
                description="COM_ALFA_CARRIER_NAME_DESC"
        />

        <!-- Package weight -->
        <field
                name="weight"
                type="number"
                label="COM_ALFA_WEIGHT"
                description=""
                step="0.001"
                min="0"
                default="0"
                required="false"
        />

        <!-- DATE FIELDS                                             -->

        <!-- Date added (auto-filled for new, editable for existing) -->
        <field
                name="added"
                type="calendar"
                label="COM_ALFA_DATE_ADDED"
                description=""
                class="form-control"
                translateformat="true"
                showtime="true"
                filter="user_utc"
        />

        <!-- Shipped timestamp: set by builder's ->shipped(), readonly in form -->
        <field
                name="shipped"
                type="calendar"
                label="COM_ALFA_SHIPPED_DATE"
                description="COM_ALFA_SHIPPED_DATE_DESC"
                class="form-control"
                translateformat="true"
                showtime="true"
                filter="user_utc"
                readonly="true"
        />

        <!-- Delivered timestamp: set by builder's ->delivered(), readonly in form -->
        <field
                name="delivered"
                type="calendar"
                label="COM_ALFA_DELIVERED_DATE"
                description="COM_ALFA_DELIVERED_DATE_DESC"
                class="form-control"
                translateformat="true"
                showtime="true"
                filter="user_utc"
                readonly="true"
        />

        <!-- HIDDEN - auto-filled by model, not shown in form/list  -->

        <field name="id" type="hidden"/>
        <field name="id_order" type="hidden"/>
        <field name="id_currency" type="hidden"/>
        <field name="id_employee" type="hidden"/>
        <field name="shipment_method_name" type="hidden"/>
        <field name="id_order_invoice" type="hidden"/>

    </fieldset>
</form>