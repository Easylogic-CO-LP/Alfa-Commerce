<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field" addruleprefix="Alfa\Component\Alfa\Administrator\Rule">
  <fieldset>


    <field
            name="id"
            type="text"
            readonly="true"
            class="readonly"
            default="0"
            description="JGLOBAL_FIELD_ID_DESC"
    />

    <field
            name="name"
            type="MultilingualText"
            multilingual_table="#__alfa_discounts"
            multilingual_pk="id_discount"
            maxlength="400"
            filter="safehtml"
            required="true"
            translateLabel="true"
            translateDescription="true"
            label="COM_ALFA_FORM_LBL_DISCOUNT_NAME"
            description="COM_ALFA_FORM_DESC_DISCOUNT_NAME"
            hint="COM_ALFA_FORM_LBL_DISCOUNT_NAME"
    />

    <!-- Customer-facing label. Optional: empty falls back to the internal name
         everywhere the shopper sees the discount (badge + price breakdown). -->
    <field
            name="name_customer"
            type="MultilingualText"
            multilingual_table="#__alfa_discounts"
            multilingual_pk="id_discount"
            maxlength="400"
            filter="safehtml"
            translateLabel="true"
            translateDescription="true"
            label="COM_ALFA_FORM_LBL_DISCOUNT_NAME_CUSTOMER"
            description="COM_ALFA_FORM_DESC_DISCOUNT_NAME_CUSTOMER"
            hint="COM_ALFA_FORM_LBL_DISCOUNT_NAME_CUSTOMER"
    />

    <field
            name="value"
            type="number"
            step="0.01"
            min="0"
            validate="discountValue"
            label="COM_ALFA_FORM_LBL_DISCOUNT_VALUE"
            required="true"
            description="COM_ALFA_FORM_DESC_DISCOUNT_VALUE"
    />

    <field
            name="behavior"
            type="radio"
            label="COM_ALFA_FORM_LBL_DISCOUNT_BEHAVIOR"
            class="btn-group"
            default="0"
            validate="options"
    >
      <option value="0">COM_ALFA_TAX_BEHAVIOR_ONLY_THIS_DISCOUNT</option>
      <option value="1">COM_ALFA_TAX_BEHAVIOR_COMBINED</option>
      <option value="2">COM_ALFA_TAX_BEHAVIOR_ONE_AFTER_ANOTHER</option>
    </field>

    <field
            name="apply_before_tax"
            type="radio"
            label="COM_ALFA_FORM_LBL_DISCOUNT_APPLY_BEFORE_TAX"
            class="btn-group"
            default="1"
            validate="options"
    >
      <option value="1">COM_ALFA_DISCOUNT_BEFORE_TAX</option>
      <option value="0">COM_ALFA_DISCOUNT_AFTER_TAX</option>
    </field>

    <!-- Sale-tag badge: the discount's name rendered in a surface slot. Two
         independent toggles (catalogue card / product page), each with its own
         slot, both off by default. -->
    <field
            name="tag_list_show"
            type="radio"
            label="COM_ALFA_FORM_LBL_DISCOUNT_TAG_LIST_SHOW"
            description="COM_ALFA_FORM_DESC_DISCOUNT_TAG_LIST_SHOW"
            class="btn-group"
            default="0"
            validate="options"
    >
      <option value="0">JNO</option>
      <option value="1">JYES</option>
    </field>

    <field
            name="tag_list_slot"
            type="list"
            label="COM_ALFA_FORM_LBL_DISCOUNT_TAG_LIST_SLOT"
            description="COM_ALFA_FORM_DESC_DISCOUNT_TAG_LIST_SLOT"
            default="image"
            showon="tag_list_show:1"
    >
      <option value="image">COM_ALFA_DISCOUNT_TAG_SLOT_IMAGE</option>
      <option value="title">COM_ALFA_DISCOUNT_TAG_SLOT_TITLE</option>
      <option value="buy-form">COM_ALFA_DISCOUNT_TAG_SLOT_BUY_FORM</option>
    </field>

    <field
            name="tag_item_show"
            type="radio"
            label="COM_ALFA_FORM_LBL_DISCOUNT_TAG_ITEM_SHOW"
            description="COM_ALFA_FORM_DESC_DISCOUNT_TAG_ITEM_SHOW"
            class="btn-group"
            default="0"
            validate="options"
    >
      <option value="0">JNO</option>
      <option value="1">JYES</option>
    </field>

    <field
            name="tag_item_slot"
            type="list"
            label="COM_ALFA_FORM_LBL_DISCOUNT_TAG_ITEM_SLOT"
            description="COM_ALFA_FORM_DESC_DISCOUNT_TAG_ITEM_SLOT"
            default="image"
            showon="tag_item_show:1"
    >
      <option value="image">COM_ALFA_DISCOUNT_TAG_SLOT_IMAGE</option>
      <option value="title">COM_ALFA_DISCOUNT_TAG_SLOT_TITLE</option>
      <option value="short-description">COM_ALFA_DISCOUNT_TAG_SLOT_SHORT_DESC</option>
      <option value="full-description">COM_ALFA_DISCOUNT_TAG_SLOT_FULL_DESC</option>
      <option value="near-add-to-cart">COM_ALFA_DISCOUNT_TAG_SLOT_NEAR_CART</option>
      <option value="specifications">COM_ALFA_DISCOUNT_TAG_SLOT_SPECS</option>
    </field>

    <!-- Badge appearance: shared across both contexts (one look per discount).
         Colours are optional: empty leaves the layout's own CSS (red badge, white
         text) in charge; setting both avoids white-on-white. tag_class appends
         free-form classes so a merchant can theme a discount without a code override. -->
    <field
            name="tag_bg"
            type="color"
            format="hex"
            default="#c0392b"
            label="COM_ALFA_FORM_LBL_DISCOUNT_TAG_BG"
            description="COM_ALFA_FORM_DESC_DISCOUNT_TAG_BG"
    />

    <field
            name="tag_color"
            type="color"
            format="hex"
            default="#ffffff"
            label="COM_ALFA_FORM_LBL_DISCOUNT_TAG_COLOR"
            description="COM_ALFA_FORM_DESC_DISCOUNT_TAG_COLOR"
    />

    <field
            name="tag_class"
            type="text"
            maxlength="190"
            label="COM_ALFA_FORM_LBL_DISCOUNT_TAG_CLASS"
            description="COM_ALFA_FORM_DESC_DISCOUNT_TAG_CLASS"
    />

    <field
            class="btn-group"
            name="is_amount"
            type="radio"
            label="COM_ALFA_FORM_LBL_DISCOUNT_IS_AMOUNT"
            default="0"
    >
      <option value="1">COM_ALFA_DISCOUNT_TYPE_AMOUNT</option>
      <option value="0">COM_ALFA_DISCOUNT_TYPE_PERCENTAGE</option>
    </field>

    <!--
        categories: 0 = applies to ALL categories.
        <option value="0"> instead of header="..." so the DB value 0
        matches the option value directly; no blank selection on load.
    -->
    <field
            name="categories"
            type="categories"
            showPath="true"
            multiple="true"
            label="COM_ALFA_FORM_LBL_CATEGORIES"
            description=""
            layout="joomla.form.field.list-fancy-select"
    >
      <option value="0">COM_ALFA_FORM_CATEGORY_ALL</option>
    </field>

    <!--
        manufacturers: 0 = applies to ALL manufacturers.
        <option value="0"> instead of header="...".
        Removed default="0": redundant when option value="0" is first.
    -->
    <field
            name="manufacturers"
            type="model"
            model="manufacturers"
            column_value="id"
            column_text="name"
            input_type="list"
            required="false"
            multiple="true"
            label="COM_ALFA_FORM_LBL_MANUFACTURERS"
            description="COM_ALFA_FORM_DESC_MANUFACTURERS"
            layout="joomla.form.field.list-fancy-select"
    >
      <option value="0">COM_ALFA_FORM_MANUFACTURER_ALL</option>
    </field>

    <!--
        places: 0 = applies to ALL places/countries.
        <option value="0"> instead of header="...".
    -->
    <field
            name="places"
            type="sql"
            required="false"
            multiple="true"
            label="COM_ALFA_FORM_CATEGORY_PLACE_LBL"
            layout="joomla.form.field.list-fancy-select"
            query="SELECT `id`, `name` AS val FROM `#__alfa_places`"
            key_field="id"
            value_field="val"
    >
      <option value="0">COM_ALFA_FORM_PLACE_ALL</option>
    </field>

    <field
            name="usergroups"
            type="usergrouplist"
            label="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERGROUPS_LBL"
            description="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERGROUPS_DESC"
            layout="joomla.form.field.list-fancy-select"
            multiple="true"
            checksuperusergroup="1"
            default="0"
    >
        <option value="0">COM_ALFA_FORM_USERGROUP_ALL</option>
    </field>

    <!--
        users: 0 = applies to ALL users (not user-specific).
        Added <option value="0">: previously missing entirely, so there was
        no way to represent "all users" in the form and nothing showed
        as selected when loading a record saved with user_id = 0.
    -->
    <field
            name="users"
            type="sql"
            input_type="list"
            required="false"
            multiple="true"
            label="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERS_LBL"
            description="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERS_DESC"
            layout="joomla.form.field.list-fancy-select"
            query="SELECT `id`, `name` AS val FROM `#__users`"
            key_field="id"
            value_field="val"
    >
      <option value="0">COM_ALFA_FORM_USER_ALL</option>
    </field>

    <field
            name="publish_up"
            type="calendar"
            showtime="true"
            format="%Y-%m-%d %H:%M"
            filter="USER_UTC"
            label="COM_ALFA_FORM_LBL_DISCOUNT_START_DATE"
            description=""
    />

    <field
            name="publish_down"
            type="calendar"
            showtime="true"
            format="%Y-%m-%d %H:%M"
            filter="USER_UTC"
            label="COM_ALFA_FORM_LBL_DISCOUNT_END_DATE"
            description=""
    />

    <field
            name="state"
            type="list"
            label="JSTATUS"
            class="form-select-color-state"
            default="1"
            validate="options"
    >
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>

    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" type="hidden" filter="unset"/>

    <field
            name="created_by"
            type="user"
            label="JGLOBAL_FIELD_CREATED_BY_LABEL"
            validate="UserId"
    />

    <field
            name="modified"
            type="calendar"
            label="JGLOBAL_FIELD_MODIFIED_LABEL"
            class="form-control"
            translateformat="true"
            showtime="true"
            readonly="true"
            filter="user_utc"
    />

    <field
            name="modified_by"
            type="user"
            label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
            class="readonly"
            readonly="true"
            filter="unset"
            validate="UserId"
    />

    <field name="ordering" type="hidden"/>

  </fieldset>
</form>