<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field">
    <fields name="filter">
        <field
                name="search"
                type="text"
                inputmode="search"
                label="COM_ALFA_FILTER_SEARCH_LABEL"
                description="COM_ALFA_TASKS_SEARCH_DESC"
                hint="COM_ALFA_TASKS_SEARCH_PLACEHOLDER"
        />

        <field
                name="work"
                type="list"
                label="COM_ALFA_TASKS_COL_STATE"
                onchange="this.form.submit();"
        >
            <option value="">COM_ALFA_TASKS_FILTER_WORK</option>
            <option value="running">COM_ALFA_TASKS_WORK_RUNNING</option>
            <option value="waiting">COM_ALFA_TASKS_WORK_WAITING</option>
            <option value="attention">COM_ALFA_TASKS_WORK_ATTENTION</option>
            <option value="finished">COM_ALFA_TASKS_WORK_FINISHED</option>
        </field>

        <field
                name="kind"
                type="taskkind"
                label="COM_ALFA_TASKS_COL_KIND"
                onchange="this.form.submit();"
        />

        <field name="date_range" type="daterange"
               label="COM_ALFA_FILTER_DATE_RANGE"
               layout="joomla.form.field.list-fancy-select"
               onchange="this.form.submit();" />

        <field name="date_start" type="calendar" default="" showtime="true"
               translateformat="true" filter="raw"
               label="COM_ALFA_FILTER_DATE_START" />

        <field name="date_end" type="calendar" default="" showtime="true"
               translateformat="true" filter="raw"
               label="COM_ALFA_FILTER_DATE_END" />
    </fields>

    <fields name="list">
        <field
                name="fullordering"
                type="list"
                label="JGLOBAL_SORT_BY"
                onchange="this.form.submit();"
                default="rank ASC"
                validate="options"
        >
            <option value="rank ASC">COM_ALFA_TASKS_SORT_RANK</option>
            <option value="a.id DESC">COM_ALFA_TASKS_SORT_NEWEST</option>
            <option value="a.id ASC">COM_ALFA_TASKS_SORT_OLDEST</option>
            <option value="a.created_at DESC">COM_ALFA_TASKS_SORT_CREATED_DESC</option>
            <option value="a.created_at ASC">COM_ALFA_TASKS_SORT_CREATED_ASC</option>
            <option value="a.finished_at DESC">COM_ALFA_TASKS_SORT_FINISHED_DESC</option>
            <option value="a.finished_at ASC">COM_ALFA_TASKS_SORT_FINISHED_ASC</option>
        </field>

        <field
                name="limit"
                type="limitbox"
                label="JGLOBAL_LIST_LIMIT"
                default="25"
                onchange="this.form.submit();"
        />
    </fields>
</form>
