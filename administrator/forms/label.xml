<?xml version="1.0" encoding="utf-8"?>
<!-- One of the shop's labels (the Labels screen, LabelModel): its name per language in the language tables, its look,
     where it shows on a card and on the product page, its corner of the image, whether the storefront filters offer it,
     and when it is published. A product ticks it on its Labels tab. -->
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field">
    <fieldset>
        <field name="name" type="MultilingualText"
               multilingual_table="#__alfa_labels" multilingual_pk="id_label"
               maxlength="100" filter="safehtml" required="true" translateLabel="true"
               label="COM_ALFA_FORM_LBL_LABEL_NAME" description="COM_ALFA_FORM_DESC_LABEL_NAME" hint="COM_ALFA_FORM_LBL_LABEL_NAME"/>

        <field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>

        <field name="bg" type="color" format="hex" default=""
               label="COM_ALFA_FORM_LBL_LABEL_BG" description="COM_ALFA_FORM_DESC_LABEL_BG"/>

        <field name="color" type="color" format="hex" default=""
               label="COM_ALFA_FORM_LBL_LABEL_COLOR" description="COM_ALFA_FORM_DESC_LABEL_COLOR"/>

        <field name="class" type="text" maxlength="190" filter="string"
               label="COM_ALFA_FORM_LBL_LABEL_CLASS" description="COM_ALFA_FORM_DESC_LABEL_CLASS"/>

        <field name="list_show" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
               label="COM_ALFA_FORM_LBL_LABEL_LIST_SHOW" description="COM_ALFA_FORM_DESC_LABEL_LIST_SHOW">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="list_slot" type="labelslot" context="list" default="image" showon="list_show:1"
               label="COM_ALFA_FORM_LBL_LABEL_LIST_SLOT" description="COM_ALFA_FORM_DESC_LABEL_LIST_SLOT"/>

        <field name="item_show" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
               label="COM_ALFA_FORM_LBL_LABEL_ITEM_SHOW" description="COM_ALFA_FORM_DESC_LABEL_ITEM_SHOW">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="item_slot" type="labelslot" context="item" default="image" showon="item_show:1"
               label="COM_ALFA_FORM_LBL_LABEL_ITEM_SLOT" description="COM_ALFA_FORM_DESC_LABEL_ITEM_SLOT"/>

        <field name="corner" type="labelcorner" default="top-left"
               label="COM_ALFA_FORM_LBL_LABEL_CORNER" description="COM_ALFA_FORM_DESC_LABEL_CORNER"/>

        <field name="filterable" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
               label="COM_ALFA_FORM_LBL_LABEL_FILTERABLE" description="COM_ALFA_FORM_DESC_LABEL_FILTERABLE">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field
                name="state"
                type="list"
                label="JSTATUS"
                class="form-select-color-state"
                default="1"
                validate="options"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field name="publish_up" type="calendar" translateformat="true" showtime="true" filter="user_utc"
               label="COM_ALFA_FORM_LBL_LABEL_PUBLISH_UP" description="COM_ALFA_FORM_DESC_LABEL_PUBLISH_UP"/>

        <field name="publish_down" type="calendar" translateformat="true" showtime="true" filter="user_utc"
               label="COM_ALFA_FORM_LBL_LABEL_PUBLISH_DOWN" description="COM_ALFA_FORM_DESC_LABEL_PUBLISH_DOWN"/>

        <field
                name="created_by"
                type="user"
                label="JGLOBAL_FIELD_CREATED_BY_LABEL"
                validate="UserId"
        />

        <field
                name="modified_by"
                type="user"
                label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
                class="readonly"
                readonly="true"
                filter="unset"
                validate="UserId"
        />

        <field
                name="modified"
                type="calendar"
                label="JGLOBAL_FIELD_MODIFIED_LABEL"
                class="form-control"
                translateformat="true"
                showtime="true"
                readonly="true"
                filter="user_utc"
        />

        <field name="checked_out" type="hidden" filter="unset"/>
        <field name="checked_out_time" type="hidden" filter="unset"/>
    </fieldset>
</form>
