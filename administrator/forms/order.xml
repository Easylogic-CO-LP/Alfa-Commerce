<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field">
    <!-- The customer SNAPSHOT of the order (who placed it: a guest, an account,
         or an account since deleted). Display-only; the delivery / invoice
         details are the dynamic checkout fields injected below this fieldset. -->
    <fieldset name="user_details">
        <field name="customer_kind" label="COM_ALFA_FORM_LBL_CUSTOMER_KIND" type="text" readonly="true" class="readonly" default="" filter="unset"/>
        <field name="user_name" label="COM_ALFA_FORM_LBL_NAME" type="text" readonly="true" class="readonly" default="" filter="unset"/>
        <field name="user_email" label="COM_ALFA_FORM_LBL_EMAIL" type="text" readonly="true" class="readonly" default="" filter="unset"/>
        <field name="id_user_group" type="hidden" default="1"/>
    </fieldset>


    

    <fieldset name="order_details">
        <field name="id" type="text" readonly="true" default="0" label="ID" description="JGLOBAL_FIELD_ID_DESC"/>

        <!-- validate=UserId: an id with no account behind it would make the
             order claim a customer that does not exist, and the email rules
             read "member" straight off this value. Empty (a guest) passes. -->
        <field
                name="id_user"
                type="user"
                label="COM_ALFA_FORM_LBL_CUSTOMER"
                description="COM_ALFA_FORM_DESC_CUSTOMER"
                validate="UserId"
        />
        <field name="id_address_delivery" type="hidden" default="1"/>

        <field
                name="id_order_status" type="model"
                model="orderstatuses"
                column_value="id"
                column_text="name"
                input_type="list"
                required="true"
                multiple="false"
                label="COM_ALFA_FORM_LBL_ORDER_STATUSES"
                description="COM_ALFA_FORM_DESC_ORDER_STATUSES"
                layout="joomla.form.field.list-fancy-select"
        />

        <!-- The order's currency by name. Read-only: an order's currency is written once, when it is placed. -->
        <field name="id_currency" type="sql" readonly="true"
               query="SELECT `id`, `name` FROM `#__alfa_currencies` ORDER BY `name`"
               key_field="id" value_field="name"
               label="COM_ALFA_FORM_LBL_CURRENCY_ID">
            <option value="">-</option>
        </field>

        <field
                name="created"
                type="calendar"
                label="COM_ALFA_FORM_ORDER_CREATED"
                class="form-control"
                translateformat="true"
                showtime="true"
                readonly="true"
                filter="user_utc"
        />

        <field
                name="created_by"
                type="user"
                label="JGLOBAL_FIELD_CREATED_BY_LABEL"
                validate="UserId"
        />

        <field
                name="modified_by"
                type="user"
                label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
                class="readonly"
                readonly="true"
                filter="unset"
                validate="UserId"
        />

        <field
                name="modified"
                type="calendar"
                label="JGLOBAL_FIELD_MODIFIED_LABEL"
                class="form-control"
                translateformat="true"
                showtime="true"
                readonly="true"
                filter="user_utc"
        />

        <field name="checked_out" type="hidden" filter="unset"/>
        <field name="checked_out_time" type="hidden" filter="unset"/>

    </fieldset>

    <field
            name="items"
            type="subform"
            buttons=""
            class=""
            formsource="administrator/components/com_alfa/forms/order_items.xml"
            label="COM_ALFA_FORM_ORDER_ITEMS"
            hiddenLabel="true"
            description=""
            multiple="true"
            layout="joomla.form.field.subform.repeatable-table"
    />

    <field
            name="shipments"
            type="subform"
            buttons=""
            class=""
            formsource="administrator/components/com_alfa/forms/order_shipments.xml"
            label="COM_ALFA_FORM_ORDER_SHIPMENTS"
            hiddenLabel="true"
            description=""
            multiple="true"
            layout="joomla.form.field.subform.repeatable-table"
    />

    <field
            name="payments"
            type="subform"
            buttons=""
            class=""
            formsource="administrator/components/com_alfa/forms/order_payments.xml"
            label="COM_ALFA_FORM_ORDER_PAYMENTS"
            hiddenLabel="true"
            description=""
            multiple="true"
            layout="joomla.form.field.subform.repeatable-table"
    />

</form>
