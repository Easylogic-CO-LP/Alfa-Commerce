<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field">

    <fieldset name="general">
        <field name="parent_id"
               type="categories"
               model="categories"
               showPath="false"
               orderBy="id"
               orderDir="desc"
               disableDescendants="true"
               layout="joomla.form.field.list-fancy-select" label="COM_ALFA_FORM_LBL_CATEGORY_PARENT_ID">
            <option value="0">COM_ALFA_FROM_CATEGORY_NO_OPTION</option>
        </field>

        <field name="name" type="MultilingualText"
               multilingual_table="#__alfa_categories" multilingual_pk="id_category"
               maxlength="400" filter="safehtml" required="true" translateLabel="true"
               translateDescription="true" label="COM_ALFA_FORM_LBL_CATEGORY_NAME"
               description="COM_ALFA_FORM_DESC_CATEGORY_NAME" hint="COM_ALFA_FORM_LBL_CATEGORY_NAME"/>

        <field name="desc" type="MultilingualEditor"
               multilingual_table="#__alfa_categories" multilingual_pk="id_category"
               filter="safehtml" label="COM_ALFA_FORM_LBL_CATEGORY_DESC"
               description="COM_ALFA_FORM_CATEGORY_DESC"/>

        <field name="alias" type="MultilingualText"
               multilingual_table="#__alfa_categories" multilingual_pk="id_category"
               label="JFIELD_ALIAS_LABEL"
               description="COM_ALFA_FORM_DESC_CATEGORY_ALIAS" hint="COM_ALFA_FORM_LBL_CATEGORY_ALIAS"/>

        <field
                name="state"
                type="list"
                label="JSTATUS"
                class="form-select-color-state"
                default="1"
                validate="options"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
                name="checked_out"
                type="hidden"
                filter="unset"
        />

        <field
                name="checked_out_time"
                type="hidden"
                filter="unset"
        />

        <field
                name="ordering"
                type="text"
                label="JFIELD_ORDERING_LABEL"
                default="0"
        />

    </fieldset>

    <fieldset name="publish">
        <field name="publish_up" type="calendar" showtime="true" format="%Y-%m-%d %H:%M" filter="USER_UTC"
               label="COM_ALFA_FORM_CATEGORY_LBL_PUBLISH_UP" description="COM_ALFA_CATEGORY_PUBLISH_UP_DESC"/>

        <field name="publish_down" type="calendar" showtime="true" format="%Y-%m-%d %H:%M" filter="USER_UTC"
               label="COM_ALFA_FORM_CATEGORY_LBL_PUBLISH_DOWN" description="COM_ALFA_CATEGORY_PUBLISH_DOWN_DESC"/>

        <field
                name="allowedUsers" type="sql"
                input_type="list"
                required="false"
                multiple="true"
                label="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERS_LBL"
                description="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERS_DESC"
                layout="joomla.form.field.list-fancy-select"
                query="SELECT `id`, `name` FROM `#__users`" key_field="id" value_field="name"
        />

        <field
                name="allowedUserGroups"
                type="usergrouplist"
                label="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERGROUPS_LBL"
                description="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERGROUPS_DESC"
                layout="joomla.form.field.list-fancy-select"
                multiple="true"
                checksuperusergroup="1"
                default="8"
        />

        <field
                name="modified_by"
                type="user"
                label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
                class="readonly"
                readonly="true"
                filter="unset"
                validate="UserId"
        />

        <field
                name="modified"
                type="calendar"
                label="JGLOBAL_FIELD_MODIFIED_LABEL"
                class="form-control"
                translateformat="true"
                showtime="true"
                readonly="true"
                filter="user_utc"
        />

        <field
                name="created_by"
                type="user"
                label="JGLOBAL_FIELD_CREATED_BY_LABEL"
                validate="UserId"
        />

        <field name="id" type="text" readonly="true" class="readonly" default="0"
               description="JGLOBAL_FIELD_ID_DESC"/>

    </fieldset>

    <fieldset name="meta" label="COM_ALFA_TAB_SEO">
        <field name="meta_title" type="MultilingualText"
               multilingual_table="#__alfa_categories" multilingual_pk="id_category"
               maxlength="60" filter="safehtml" translateLabel="true"
               translateDescription="true" label="COM_ALFA_FORM_LBL_CATEGORY_META_TITLE"
               description="COM_ALFA_FORM_DESC_CATEGORY_META_TITLE" hint="COM_ALFA_FORM_LBL_CATEGORY_META_TITLE"/>

        <field name="meta_desc" type="MultilingualText"
               multilingual_table="#__alfa_categories" multilingual_pk="id_category"
               maxlength="160" filter="safehtml"
               label="JFIELD_META_DESCRIPTION_LABEL" description="COM_ALFA_FORM_DESC_CATEGORY_META_DESC"
               hint="COM_ALFA_FORM_LBL_CATEGORY_META_DESC"/>

        <field
                name="robots"
                type="list"
                label="JFIELD_METADATA_ROBOTS_LABEL"
                validate="options"
        >
            <option value="">JGLOBAL_USE_GLOBAL</option>
            <option value="index, follow">COM_ALFA_ROBOTS_INDEX_FOLLOW</option>
            <option value="noindex, follow">COM_ALFA_ROBOTS_NOINDEX_FOLLOW</option>
            <option value="index, nofollow">COM_ALFA_ROBOTS_INDEX_NOFOLLOW</option>
            <option value="noindex, nofollow">COM_ALFA_ROBOTS_NOINDEX_NOFOLLOW</option>
        </field>
    </fieldset>

    <fieldset name="Image" label="COM_ALFA_FIELDSET_IMAGE">
        <field
                name="medias"
                type="MediaZone"
                label="Insert Media: "
                multiple="false"
                hiddenLabel="true"
                types="media"
        />
    </fieldset>

    <!-- Layout overrides for THIS category and the products shown under it;
         every key inherits menu -> global when empty (products may override per item). -->
    <fields name="layouts">
        <fieldset name="layouts" label="COM_ALFA_MENU_LAYOUTS_OPTIONS">

            <field
                    name="layout"
                    type="viewLayout"
                    view="items"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEMS_LABEL"
            />

            <field
                    name="card"
                    type="subtemplate"
                    view="items"
                    slot="item"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEMS_CARD_LABEL"
            />

            <field
                    name="list_categories"
                    type="subtemplate"
                    view="items"
                    slot="categories"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEMS_CATEGORIES_LABEL"
            />

            <field
                    name="item"
                    type="viewLayout"
                    view="item"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEM_LABEL"
            />

            <field
                    name="images"
                    type="subtemplate"
                    view="item"
                    slot="images"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEM_IMAGES_LABEL"
            />

            <field
                    name="manufacturers"
                    type="subtemplate"
                    view="item"
                    slot="manufacturers"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEM_MANUFACTURERS_LABEL"
            />

            <field
                    name="categories"
                    type="subtemplate"
                    view="item"
                    slot="categories"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEM_CATEGORIES_LABEL"
            />
        </fieldset>
    </fields>

    <!-- How a listing of THIS category paginates and sorts by default. Top of
         the chain: empty inherits the menu item, then the global config. One
         JSON column, so the next per-category list setting needs no migration. -->
    <fields name="list_options">
        <fieldset
                name="list_options"
                label="COM_ALFA_LIST_OPTIONS"
                addruleprefix="Alfa\Component\Alfa\Administrator\Rule"
        >

            <field
                    name="items_limit"
                    type="listLimit"
                    globalparam="items_limit"
                    inheritlabel="COM_ALFA_INHERIT"
                    min="0"
                    label="COM_ALFA_CONFIG_ITEMS_LIMIT"
                    description="COM_ALFA_CATEGORY_INHERIT_DESC"
                    validate="listLimit"
            />

            <field
                    name="items_limits"
                    type="listLimits"
                    globalparam="items_limits"
                    inheritlabel="COM_ALFA_INHERIT"
                    label="COM_ALFA_CONFIG_ITEMS_LIMITS"
                    description="COM_ALFA_CATEGORY_INHERIT_DESC"
                    validate="listLimits"
            />

            <field
                    name="items_ordering"
                    type="listOrdering"
                    view="items"
                    globalparam="items_ordering"
                    inheritlabel="COM_ALFA_INHERIT"
                    label="COM_ALFA_CONFIG_ITEMS_ORDERING"
                    description="COM_ALFA_CATEGORY_INHERIT_DESC"
                    validate="options"
            />
        </fieldset>
    </fields>
</form>