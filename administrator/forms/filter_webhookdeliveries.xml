<?xml version="1.0" encoding="UTF-8"?>
<!--
    One webhook's deliveries: by status (delivered, failed, pending), newest first. The webhook itself is named by
    webhook_id in every request of the list, never kept as a filter.
-->
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field">
    <fields name="filter">
        <field
                name="state"
                type="list"
                label="JSTATUS"
                onchange="this.form.submit();"
        >
            <option value="">COM_ALFA_WEBHOOK_DELIVERIES_FILTER_STATE</option>
            <option value="delivered">COM_ALFA_WEBHOOK_DELIVERIES_FILTER_DELIVERED</option>
            <option value="failed">COM_ALFA_WEBHOOK_DELIVERIES_FILTER_FAILED</option>
            <option value="pending">COM_ALFA_WEBHOOK_DELIVERIES_FILTER_PENDING</option>
        </field>
    </fields>

    <fields name="list">
        <field
                name="fullordering"
                type="list"
                label="JGLOBAL_SORT_BY"
                onchange="this.form.submit();"
                default="a.id DESC"
                validate="options"
        >
            <option value="a.id DESC">COM_ALFA_WEBHOOK_DELIVERIES_SORT_NEWEST</option>
            <option value="a.id ASC">COM_ALFA_WEBHOOK_DELIVERIES_SORT_OLDEST</option>
        </field>

        <field
                name="limit"
                type="limitbox"
                label="JGLOBAL_LIST_LIMIT"
                default="25"
                onchange="this.form.submit();"
        />
    </fields>
</form>
