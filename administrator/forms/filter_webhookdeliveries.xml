<?xml version="1.0" encoding="UTF-8"?>
<!--
    One webhook's deliveries: by status (delivered, failed, pending), newest first. The webhook itself is named by
    webhook_id in every request of the list, never kept as a filter.
-->
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field">
    <fields name="filter">
        <field
                name="work"
                type="list"
                label="COM_ALFA_TASKS_COL_STATE"
                onchange="this.form.submit();"
        >
            <option value="">COM_ALFA_TASKS_FILTER_WORK</option>
            <option value="running">COM_ALFA_TASKS_WORK_RUNNING</option>
            <option value="waiting">COM_ALFA_TASKS_WORK_WAITING</option>
            <option value="attention">COM_ALFA_TASKS_WORK_ATTENTION</option>
            <option value="finished">COM_ALFA_TASKS_WORK_FINISHED</option>
        </field>
    </fields>

    <fields name="list">
        <field
                name="fullordering"
                type="list"
                label="JGLOBAL_SORT_BY"
                onchange="this.form.submit();"
                default="d.id DESC"
                validate="options"
        >
            <option value="d.id DESC">COM_ALFA_WEBHOOK_DELIVERIES_SORT_NEWEST</option>
            <option value="d.id ASC">COM_ALFA_WEBHOOK_DELIVERIES_SORT_OLDEST</option>
        </field>

        <field
                name="limit"
                type="limitbox"
                label="JGLOBAL_LIST_LIMIT"
                default="25"
                onchange="this.form.submit();"
        />
    </fields>
</form>
