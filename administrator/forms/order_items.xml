<?xml version="1.0" encoding="UTF-8"?>
<!--
    Order Items Form Definition

    Used in TWO contexts (same pattern as order_payments.xml):
    1. LIST (edit_order_items.php): loadSubForm()->getFieldset() for table headers
    2. POPUP (edit_order_item.php): renderFieldset('order_item') for edit form

    Hidden fields: not shown in list table, rendered as <input type="hidden"> in popup
    Visible fields: shown as <th> in list, rendered as form controls in popup
    Readonly fields: displayed in list, shown but not editable in popup
-->
<form>
    <fieldset name="order_item">

        <!-- HIDDEN: System fields (not visible in list) -->
        <field
                name="id"
                type="hidden"
                default="0"
                readonly="true"
                label="JGLOBAL_FIELD_ID_LABEL"
        />

        <field
                name="id_order"
                type="hidden"
                default="0"
        />

        <field
                name="id_item"
                type="hidden"
                default="0"
                label="COM_ALFA_ORDER_ITEM_PRODUCT_ID"
        />

        <!-- VISIBLE: Product snapshot (shown in list + readonly in popup) -->
        <field
                name="name"
                type="text"
                label="COM_ALFA_FORM_LBL_PRODUCT"
                readonly="true"
                class="readonly"
                description=""
        />

        <field
                name="sku"
                type="text"
                label="COM_ALFA_FORM_LBL_SKU"
                readonly="true"
                class="readonly"
                description="COM_ALFA_SKU_DESC"
        />

        <!-- EDITABLE: the quantity. The price is not a field: the popup's -->
        <!-- price command (layout order.item_price_command) says how the  -->
        <!-- line's one custom-price column changes, and the save prices.  -->
        <field
                name="quantity"
                type="number"
                label="COM_ALFA_FORM_LBL_QUANTITY"
                description=""
                required="true"
                min="1"
                step="1"
                default="1"
        />

        <!-- READONLY: the line's money, as the save wrote it. Derived    -->
        <!-- columns, shown in the list; never posted back as an input.   -->
        <field
                name="unit_price_tax_incl"
                type="number"
                label="COM_ALFA_FORM_LBL_UNIT_PRICE"
                description=""
                readonly="true"
                step="0.01"
        />

        <field
                name="unit_price_tax_excl"
                type="number"
                label="COM_ALFA_FORM_LBL_PRICE_TAX_EXCL"
                step="0.01"
                min="0"
        />

        <field
                name="total_price_tax_incl"
                type="number"
                label="COM_ALFA_FORM_LBL_TOTAL_PRICE"
                step="0.01"
                min="0"
        />

        <field
                name="discount_percent"
                type="number"
                label="COM_ALFA_FORM_LBL_DISCOUNT_PERCENT"
                step="0.01"
                min="0"
                max="100"
        />

        <field
                name="discount_amount_tax_incl"
                type="number"
                label="COM_ALFA_FORM_LBL_DISCOUNT_AMOUNT"
                step="0.01"
                min="0"
        />

        <field
                name="tax_rate"
                type="text"
                label="COM_ALFA_FORM_LBL_TAX_RATE"
                readonly="true"
                class="readonly"
        />

    </fieldset>
</form>