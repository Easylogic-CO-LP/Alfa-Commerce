<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" description="COM_ALFA_SEARCH_FILTER_SUBMIT"
               label="COM_ALFA_FILTER_SEARCH_LABEL"
               hint="COM_ALFA_USERS_SEARCH_PLACEHOLDER"
               class="js-stools-search-string" />

        

    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_ALFA_LIST_FULL_ORDERING"
               description="COM_ALFA_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.id ASC">COM_ALFA_ID_ASC</option><option value="a.id DESC">COM_ALFA_ID_DESC</option><option value="u.username ASC">COM_ALFA_USERNAME_ASC</option><option value="u.username DESC">COM_ALFA_USERNAME_DESC</option><option value="u.email ASC">COM_ALFA_EMAIL_ASC</option><option value="u.email DESC">COM_ALFA_EMAIL_DESC</option><option value="u.lastvisitDate ASC">COM_ALFA_LASTVISIT_ASC</option><option value="u.lastvisitDate DESC">COM_ALFA_LASTVISIT_DESC</option>

        </field>

       <field name="limit"
               type="limitbox"
               label="COM_ALFA_LIST_LIMIT"
               description="COM_ALFA_LIST_LIMIT_DESC"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>