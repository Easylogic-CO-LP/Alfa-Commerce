<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field">

    <fieldset name="general">

        <field name="short_desc" type="MultilingualEditor"
               multilingual_table="#__alfa_items" multilingual_pk="id_item"
               cols="30" rows="3" editor="|" buttons="true" filter="Joomla\CMS\Component\ComponentHelper::filterText"
               label="COM_ALFA_FORM_LBL_ITEM_SHORT_DESC"
               description="COM_ALFA_FORM_DESC_ITEM_SHORT_DESC"/>

        <field name="full_desc" type="MultilingualEditor"
               multilingual_table="#__alfa_items" multilingual_pk="id_item"
               cols="30" rows="3" editor="|" buttons="true" filter="Joomla\CMS\Component\ComponentHelper::filterText"
               label="COM_ALFA_FORM_LBL_ITEM_FULL_DESC" description="COM_ALFA_FORM_DESC_ITEM_FULL_DESC"/>

    </fieldset>

    <!-- The three machine identities, rendered together at the head of the
         General tab. Their own fieldset so the Logistics tab can render the
         inventory one whole. -->
    <fieldset name="identity" label="COM_ALFA_ITEM_GROUP_IDENTITY">
        <field name="sku" size="255" filter="safehtml" type="text" translateLabel="true" translateDescription="true"
               label="COM_ALFA_FORM_LBL_ITEM_SKU" description="COM_ALFA_FORM_DESC_ITEM_SKU"/>

        <field name="gtin" size="255" filter="safehtml" type="text" translateLabel="true" translateDescription="true"
               label="COM_ALFA_FORM_LBL_ITEM_GTIN" description="COM_ALFA_FORM_DESC_ITEM_GTIN"/>

        <field name="mpn" size="255" filter="safehtml" type="text" translateLabel="true" translateDescription="true"
               label="COM_ALFA_FORM_LBL_ITEM_MPN" description="COM_ALFA_FORM_DESC_ITEM_MPN"/>
    </fieldset>

    <!-- The Logistics tab, in render order; the template only calls
         renderFieldset('inventory'). Order is the merchant's train of thought:
         how much is there -> does it ship and how big -> how much may they buy
         -> thresholds and policy -> what the shopper is told. The spacers are
         the separating rules; every field carries its own showon. -->
    <fieldset name="inventory" label="COM_ALFA_TAB_ITEM_INVENTORY">
        <!-- The switch leads the quantity it reveals (showon="manage_stock:1"). -->
        <field name="manage_stock" type="radio"
               class="btn-group"
               label="COM_ALFA_FORM_LBL_ITEM_MANAGE_STOCK"
               description="COM_ALFA_FORM_DESC_ITEM_MANAGE_STOCK"
               default="1">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="stock" type="InventoryStock" label="COM_ALFA_FORM_LBL_ITEM_STOCK"
               description="COM_ALFA_FORM_DESC_ITEM_STOCK"
               showon="manage_stock:1"/>

        <!-- Four-valued enum resolved by StockVisibilityPolicy: -1 inherits the
             shop-wide setting, 0 none, 1 notify button, 2 hide when out of stock.
             This option list also drives the per-combination override select
             (ItemFieldsAdminHelper::getCombinationOverrideDescriptors). -->
        <field name="stock_action" type="list"
               label="COM_ALFA_FORM_LBL_ITEM_STOCK_ACTION"
               description="COM_ALFA_FORM_DESC_ITEM_STOCK_ACTION"
               multiple="false"
               default="-1">
            <option value="-1">COM_ALFA_FORM_LBL_ITEM_STOCK_ACTION_CONFIGURATION</option>
            <option value="0">COM_ALFA_FORM_LBL_ITEM_STOCK_ACTION_NO_ACTION</option>
            <option value="1">COM_ALFA_FORM_LBL_ITEM_STOCK_ACTION_NOTIFY</option>
            <option value="2">COM_ALFA_FORM_LBL_ITEM_STOCK_ACTION_HIDE_OUT_OF_STOCK</option>
        </field>

        <field name="rule_shipping" type="spacer" hr="true" class="alfa-group-rule"/>

        <!-- Shipping shape
             The dimensions sit with is_virtual because that switch is what
             hides them. -->
        <field name="is_virtual" type="radio"
               class="btn-group"
               label="COM_ALFA_FORM_LBL_ITEM_IS_VIRTUAL"
               description="COM_ALFA_FORM_DESC_ITEM_IS_VIRTUAL"
               default="0">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field
                name="width"
                type="number"
                showon="is_virtual:0"
                label="COM_ALFA_FORM_LBL_ITEM_WIDTH"
                description="COM_ALFA_FORM_DESC_ITEM_WIDTH"
                default="0"
                min="0"
        />

        <field
                name="height"
                type="number"
                showon="is_virtual:0"
                label="COM_ALFA_FORM_LBL_ITEM_HEIGHT"
                description="COM_ALFA_FORM_DESC_ITEM_HEIGHT"
                default="0"
                min="0"
        />

        <field
                name="depth"
                type="number"
                showon="is_virtual:0"
                label="COM_ALFA_FORM_LBL_ITEM_DEPTH"
                description="COM_ALFA_FORM_DESC_ITEM_DEPTH"
                default="0"
                min="0"
        />

        <field
                name="weight"
                type="number"
                showon="is_virtual:0"
                label="COM_ALFA_FORM_LBL_ITEM_WEIGHT"
                description="COM_ALFA_FORM_DESC_ITEM_WEIGHT"
                default="0"
                min="0"
        />

        <field name="rule_limits" type="spacer" hr="true" class="alfa-group-rule"/>

        <!-- Purchase limits: what a shopper may put in the cart
             Enforced by the cart quantity policy on every add and update.
             Independent of stock: they apply even when stock is not managed.
             They are exact decimals, so they are text inputs: a number input
             renders its value through a float, which rounds long values and
             writes small ones with an exponent. The model parses every posted
             value exactly and refuses one outside the quantity precision. -->
        <field
                name="quantity_min"
                type="text"
                inputmode="decimal"
                label="COM_ALFA_FORM_LBL_ITEM_QUANTITY_MIN"
                description="COM_ALFA_FORM_DESC_ITEM_QUANTITY_MIN"
                default="1"
        />
        <field
                name="quantity_max"
                type="text"
                inputmode="decimal"
                label="COM_ALFA_FORM_LBL_ITEM_QUANTITY_MAX"
                description="COM_ALFA_FORM_DESC_ITEM_QUANTITY_MAX"
        />
        <field
                name="quantity_step"
                type="text"
                inputmode="decimal"
                label="COM_ALFA_FORM_LBL_ITEM_QUANTITY_STEP"
                description="COM_ALFA_FORM_DESC_ITEM_QUANTITY_STEP"
                default="1"
        />

        <field name="rule_policy" type="spacer" hr="true" class="alfa-group-rule"/>

        <!-- Stock policy: overrides of the shop-wide inventory rules.
             Empty means "use the global setting". Both only matter when stock
             is managed, hence the showon. -->
        <field name="backorder" type="list"
               label="COM_ALFA_FORM_LBL_ITEM_BACKORDER"
               description="COM_ALFA_FORM_DESC_ITEM_BACKORDER"
               useglobal="true"
               showon="manage_stock:1">
            <option value="deny">COM_ALFA_CONFIG_INVENTORY_BACKORDER_DENY</option>
            <option value="allow">COM_ALFA_CONFIG_INVENTORY_BACKORDER_ALLOW</option>
            <option value="allow_notify">COM_ALFA_CONFIG_INVENTORY_BACKORDER_ALLOW_NOTIFY</option>
        </field>

        <field name="min_qty" type="number" min="0"
               label="COM_ALFA_FORM_LBL_ITEM_MIN_QTY"
               description="COM_ALFA_FORM_DESC_ITEM_MIN_QTY"
               useglobal="true"
               showon="manage_stock:1"/>

        <field name="rule_messages" type="spacer" hr="true" class="alfa-group-rule"/>

        <!-- Low stock and what the shopper is told
             stock_low is the trigger for both the notify switch and the low
             stock message (showon="stock_low!:"), so it leads them. -->
        <field
                name="stock_low"
                type="number"
                useglobal="true"
                showon="manage_stock:1"
                label="COM_ALFA_FORM_LBL_ITEM_LOW_STOCK_VALUE"
                description="COM_ALFA_FORM_DESC_ITEM_LOW_STOCK_VALUE"
        />

        <field
                name="low_stock_notify"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                default="0"
                label="COM_ALFA_FORM_LBL_ITEM_LOW_STOCK_NOTIFY"
                description="COM_ALFA_FORM_DESC_ITEM_LOW_STOCK_NOTIFY"
                showon="stock_low!:">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="stock_low_message" type="MultilingualEditor"
               multilingual_table="#__alfa_items" multilingual_pk="id_item"
               cols="30" rows="3" editor="|" buttons="true" filter="Joomla\CMS\Component\ComponentHelper::filterText"
               label="COM_ALFA_FORM_LBL_ITEM_LOW_STOCK_MESSAGE"
               description="COM_ALFA_FORM_DESC_ITEM_LOW_STOCK_MESSAGE"
               showon="stock_low!:"/>

        <field name="stock_zero_message" type="MultilingualEditor"
               multilingual_table="#__alfa_items" multilingual_pk="id_item"
               cols="30" rows="3" editor="|" buttons="true" filter="Joomla\CMS\Component\ComponentHelper::filterText"
               label="COM_ALFA_FORM_LBL_ITEM_ZERO_STOCK_MESSAGE"
               description="COM_ALFA_FORM_DESC_ITEM_ZERO_STOCK_MESSAGE"/>
    </fieldset>

    <fieldset>
        <field
                name="state"
                type="list"
                label="JSTATUS"
                class="form-select-color-state"
                default="1"
                validate="options"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field name="ordering"/>
        <field name="checked_out" type="hidden" filter="unset"/>
        <field name="checked_out_time" type="hidden" filter="unset"/>

        <!--    <field name="name" type="multilingualText" required="false" label="COM_ALFA_FORM_LBL_ITEM_NAME" description="COM_ALFA_FORM_DESC_ITEM_NAME" />-->

        <field name="name" type="MultilingualText"
               multilingual_table="#__alfa_items" multilingual_pk="id_item"
               maxlength="400" filter="safehtml" required="true" translateLabel="true"
               label="COM_ALFA_FORM_LBL_ITEM_NAME" description="COM_ALFA_FORM_DESC_ITEM_NAME"/>

        <field name="alias" type="MultilingualText"
               multilingual_table="#__alfa_items" multilingual_pk="id_item"
               label="JFIELD_ALIAS_LABEL" description="COM_ALFA_FORM_DESC_ITEM_ALIAS"/>

        <field name="id_category_default" type="categories" required="true" showPath="true" multiple="false"
               layout="joomla.form.field.list-fancy-select" label="COM_ALFA_FORM_LBL_ITEM_DEFAULT_CATEGORY" description="">
        </field>

        <field name="categories" type="categories" showPath="true" multiple="true"
               layout="joomla.form.field.list-fancy-select" label="COM_ALFA_FORM_LBL_CATEGORIES" description="">
        </field>

        <field
                name="manufacturers" type="model"
                model="manufacturers"
                column_value="id"
                column_text="name"
                input_type="list"
                required="false"
                multiple="true"
                label="COM_ALFA_FORM_LBL_MANUFACTURERS"
                description="COM_ALFA_FORM_DESC_MANUFACTURERS"
                layout="joomla.form.field.list-fancy-select"
        />

        <field
                name="prices"
                type="alfaprices"
                label="COM_ALFA_FORM_FIELDSET_PRICE"
                description="COM_ALFA_FORM_FIELDSET_PRICE_DESC"
                hiddenLabel="true"
        />

    </fieldset>

    <fieldset name="Images" label="COM_ALFA_FIELDSET_IMAGES">
        <field
                name="medias"
                type="MediaZone"
                label="COM_ALFA_FORM_LBL_MEDIAS"
                multiple="true"
                hiddenLabel="true"
                types="media,url"
        />
    </fieldset>

    <fieldset name="publish">
        <field name="publish_up" type="calendar" showtime="true" format="%Y-%m-%d %H:%M" filter="USER_UTC"
               label="COM_ALFA_FORM_CATEGORY_LBL_PUBLISH_UP" description="COM_ALFA_CATEGORY_PUBLISH_UP_DESC"/>

        <field name="publish_down" type="calendar" showtime="true" format="%Y-%m-%d %H:%M" filter="USER_UTC"
               label="COM_ALFA_FORM_CATEGORY_LBL_PUBLISH_DOWN" description="COM_ALFA_CATEGORY_PUBLISH_DOWN_DESC"/>

        <field
                name="inherited_audience"
                type="InheritedAudience"
                label="COM_ALFA_ITEM_AUDIENCE_INHERITED_LBL"
                description="COM_ALFA_ITEM_AUDIENCE_INHERITED_DESC"
        />

        <field
                name="allowedUsers" type="sql"
                input_type="list"
                required="false"
                multiple="true"
                label="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERS_LBL"
                description="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERS_DESC"
                layout="joomla.form.field.list-fancy-select"
                query="SELECT `id`, `name` FROM `#__users`" key_field="id" value_field="name"
        />

        <field
                name="allowedUserGroups"
                type="usergrouplist"
                label="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERGROUPS_LBL"
                description="COM_ALFA_FORM_CATEGORY_ALLOWEDUSERGROUPS_DESC"
                layout="joomla.form.field.list-fancy-select"
                multiple="true"
                checksuperusergroup="1"
                default="8"
        />

        <field
                name="modified_by"
                type="user"
                label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
                class="readonly"
                readonly="true"
                filter="unset"
                validate="UserId"
        />

        <field
                name="modified"
                type="calendar"
                label="JGLOBAL_FIELD_MODIFIED_LABEL"
                class="form-control"
                translateformat="true"
                showtime="true"
                readonly="true"
                filter="user_utc"
        />

        <field
                name="created_by"
                type="user"
                label="JGLOBAL_FIELD_CREATED_BY_LABEL"
                validate="UserId"
        />

        <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>

    </fieldset>

    <fieldset name="meta" label="COM_ALFA_TAB_SEO">
        <field name="meta_title" type="MultilingualText"
               multilingual_table="#__alfa_items" multilingual_pk="id_item"
               maxlength="255" filter="safehtml" translateLabel="true"
               translateDescription="true" label="COM_ALFA_FORM_LBL_ITEM_META_TITLE"
               description="COM_ALFA_FORM_DESC_ITEM_META_TITLE"/>
        <field name="meta_desc" type="MultilingualText"
               multilingual_table="#__alfa_items" multilingual_pk="id_item"
               maxlength="255" filter="safehtml"
               label="JFIELD_META_DESCRIPTION_LABEL" description="COM_ALFA_FORM_DESC_ITEM_META_DESC"/>

        <field
                name="robots"
                type="list"
                label="JFIELD_METADATA_ROBOTS_LABEL"
                validate="options"
        >
            <option value="">JGLOBAL_USE_GLOBAL</option>
            <option value="index, follow">COM_ALFA_ROBOTS_INDEX_FOLLOW</option>
            <option value="noindex, follow">COM_ALFA_ROBOTS_NOINDEX_FOLLOW</option>
            <option value="index, nofollow">COM_ALFA_ROBOTS_INDEX_NOFOLLOW</option>
            <option value="noindex, nofollow">COM_ALFA_ROBOTS_NOINDEX_NOFOLLOW</option>
        </field>
    </fieldset>

    <!-- Layout overrides for THIS product; every key inherits category -> menu -> global when empty. -->
    <fields name="layouts">
        <fieldset name="layouts" label="COM_ALFA_MENU_LAYOUTS_OPTIONS">

            <field
                    name="card"
                    type="subtemplate"
                    view="items"
                    slot="item"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEMS_CARD_LABEL"
            />

            <field
                    name="layout"
                    type="viewLayout"
                    view="item"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEM_LABEL"
            />

            <field
                    name="images"
                    type="subtemplate"
                    view="item"
                    slot="images"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEM_IMAGES_LABEL"
            />

            <field
                    name="manufacturers"
                    type="subtemplate"
                    view="item"
                    slot="manufacturers"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEM_MANUFACTURERS_LABEL"
            />

            <field
                    name="categories"
                    type="subtemplate"
                    view="item"
                    slot="categories"
                    inheritlabel="COM_ALFA_LAYOUT_INHERIT"
                    label="COM_ALFA_LAYOUT_ITEM_CATEGORIES_LABEL"
            />
        </fieldset>
    </fields>
</form>