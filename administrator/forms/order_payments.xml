<?xml version="1.0" encoding="UTF-8"?>
<!--
    Payment form: complete coverage of #__alfa_order_payments columns.

    Used for BOTH:
    1. Popup add/edit form (getPaymentForm -> edit_payment.php)
    2. List column definitions (edit_payments.php subform)

    Field groups:
      CORE:     id_payment_method, amount, payment_type, transaction_status, note
      GATEWAY:  transaction_id, gateway_response, processed_at
      REFUND:   refund_type, refund_reason, id_refunded_payment, id_document
      META:     added
      HIDDEN:   id, id_order, id_currency, conversion_rate,
                payment_method, order_reference, id_employee

    List fields (payment_type, transaction_status, refund_type) have
    NO static options; always injected by OrderModel::getPaymentForm()
    from PaymentLedger constants. Single source of truth.

    DB: #__alfa_order_payments
-->
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field" addruleprefix="Alfa\Component\Alfa\Administrator\Rule">
    <fieldset name="payment">

        <!-- CORE FIELDS                                             -->

        <!-- Payment method (dropdown from payments table) -->
        <field
                name="id_payment_method" type="model"
                model="payments"
                column_value="id"
                column_text="name"
                input_type="list"
                required="true"
                multiple="false"
                label="COM_ALFA_PAYMENT_METHOD"
                description="COM_ALFA_PAYMENT_METHOD_DESC"
                layout="joomla.form.field.list-fancy-select"
        />

        <!-- Amount (tax inclusive). An amount of the order's money exactly as
             typed: the input steps by the order's smallest unit, and one finer
             than the order's currency is refused, never rounded. -->
        <field
                name="amount"
                type="orderMoney"
                label="COM_ALFA_AMOUNT"
                description="COM_ALFA_AMOUNT_DESC"
                required="true"
                validate="orderMoney"
                sign="positive"
        />

        <!-- Payment type: options injected by model from PaymentLedger::allTypes() -->
        <field
                name="payment_type"
                type="list"
                label="COM_ALFA_PAYMENT_TYPE"
                description="COM_ALFA_PAYMENT_TYPE_DESC"
                default="payment"
                required="true"
        />

        <!-- Transaction status: options injected by model from PaymentLedger::allStatuses() -->
        <field
                name="transaction_status"
                type="list"
                label="COM_ALFA_TRANSACTION_STATUS"
                description="COM_ALFA_TRANSACTION_STATUS_DESC"
                default="completed"
                required="true"
        />

        <!-- Internal label for this movement: what tells a deposit row from
             its balance row in the grid. Never shown to the customer. -->
        <field
                name="note"
                type="text"
                maxlength="255"
                label="COM_ALFA_PAYMENT_NOTE"
                description="COM_ALFA_PAYMENT_NOTE_DESC"
        />

        <!-- GATEWAY FIELDS                                          -->

        <!-- Transaction ID from payment gateway (charge ID, txn reference, etc.) -->
        <field
                name="transaction_id"
                type="text"
                label="COM_ALFA_TRANSACTION_ID"
                description="COM_ALFA_TRANSACTION_ID_DESC"
        />

        <!-- When payment was confirmed by gateway or admin -->
        <field
                name="processed_at"
                type="calendar"
                label="COM_ALFA_PROCESSED_AT"
                description="COM_ALFA_PROCESSED_AT_DESC"
                class="form-control"
                translateformat="true"
                showtime="true"
                filter="user_utc"
        />

        <!-- Complete JSON from gateway (card details, metadata, everything) -->
        <field
                name="gateway_response"
                type="textarea"
                label="COM_ALFA_GATEWAY_RESPONSE"
                description="COM_ALFA_GATEWAY_RESPONSE_DESC"
                rows="4"
                readonly="true"
                class="form-control font-monospace"
        />

        <!-- REFUND FIELDS                                           -->
        <!-- Visible when payment_type = 'refund' or editing a       -->
        <!-- refunded payment. Hidden for normal payments.           -->

        <!-- Refund type: options injected by model from PaymentLedger::allRefundTypes() -->
        <field
                name="refund_type"
                type="list"
                label="COM_ALFA_REFUND_TYPE"
                description="COM_ALFA_REFUND_TYPE_DESC"
        />

        <!-- Reason for the refund (free text) -->
        <field
                name="refund_reason"
                type="text"
                label="COM_ALFA_REFUND_REASON"
                description="COM_ALFA_REFUND_REASON_DESC"
        />

        <!-- Links this refund record to the original payment it refunds -->
        <field
                name="id_refunded_payment"
                type="number"
                label="COM_ALFA_REFUNDED_PAYMENT_ID"
                description="COM_ALFA_REFUNDED_PAYMENT_ID_DESC"
                readonly="true"
        />

        <!-- Links this refund to the credit note it settles. Empty is valid:
             a goodwill or offline refund has no document.

             EDITABLE by design. This is the ATTRIBUTION primitive, the only
             way to answer "how much of credit note #N has actually been
             refunded", which anything recording an intention to refund (an
             RMA's destination, a credit note's own status) must report from.
             It was readonly and no code path ever set it, so the question had
             no answer and consumers were forced towards the order-wide refund
             total, which is WRONG: an order with two credit notes of 50, one
             refunded, would report both as settled. -->
        <field
                name="id_document"
                type="CreditDocument"
                label="COM_ALFA_REFUNDED_DOCUMENT_ID"
                description="COM_ALFA_REFUNDED_DOCUMENT_ID_DESC"
        >
            <!-- '' and not 0: the column is nullable and PaymentLedger maps
                 '' -> NULL, so "none" clears the attribution instead of
                 pointing it at document #0. -->
            <option value="">COM_ALFA_REFUNDED_DOCUMENT_NONE</option>
        </field>

        <!-- META FIELDS                                             -->

        <!-- Date added -->
        <field
                name="added"
                type="calendar"
                label="COM_ALFA_DATE_ADDED"
                description="COM_ALFA_DATE_ADDED_DESC"
                class="form-control"
                translateformat="true"
                showtime="true"
                filter="user_utc"
        />

        <!-- Employee audit stamp: auto-filled by PaymentLedger::create();
             hidden so an empty required picker can't block manual payments. -->
        <field name="id_employee" type="hidden"/>

        <!-- HIDDEN - auto-filled by model, not shown in form/list  -->

        <field name="id" type="hidden"/>
        <field name="id_order" type="hidden"/>
        <field name="id_currency" type="hidden"/>
        <field name="conversion_rate" type="hidden" default="1.00"/>
        <field name="payment_method" type="hidden"/>
        <field name="order_reference" type="hidden"/>

    </fieldset>
</form>