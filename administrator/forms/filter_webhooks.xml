<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Alfa\Component\Alfa\Administrator\Field">
    <fields name="filter">
        <field
                name="search"
                type="text"
                inputmode="search"
                label="COM_ALFA_FILTER_SEARCH_LABEL"
                hint="COM_ALFA_WEBHOOKS_SEARCH_PLACEHOLDER"
        />

        <field
                name="state"
                type="list"
                label="JOPTION_SELECT_PUBLISHED"
                onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
            <option value="1">COM_ALFA_WEBHOOK_STATE_ENABLED</option>
            <option value="0">COM_ALFA_WEBHOOK_STATE_PAUSED</option>
        </field>
    </fields>

    <fields name="list">
        <field
                name="fullordering"
                type="list"
                label="JGLOBAL_SORT_BY"
                onchange="this.form.submit();"
                default="a.name ASC"
                validate="options"
        >
            <option value="a.name ASC">COM_ALFA_WEBHOOKS_SORT_NAME_ASC</option>
            <option value="a.name DESC">COM_ALFA_WEBHOOKS_SORT_NAME_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>

        <field
                name="limit"
                type="limitbox"
                label="JGLOBAL_LIST_LIMIT"
                default="25"
                onchange="this.form.submit();"
        />
    </fields>
</form>
