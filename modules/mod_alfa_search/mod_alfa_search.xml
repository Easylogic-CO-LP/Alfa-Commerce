<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>mod_alfa_search</name>
    <author>Alex K</author>
    <creationDate>2024-8-26</creationDate>
    <copyright>(C) 2024-2026 Easylogic CO LP / Agamemnon Fakas. All rights reserved.</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE</license>
    <authorEmail>info@easylogic.gr</authorEmail>
    <version>1.0.0</version>
    <description>MOD_ALFA_SEARCH_DESC</description>
    <namespace path="src">Alfa\Module\AlfaSearch</namespace>
    <files>
        <folder module="mod_alfa_search">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <media destination="mod_alfa_search" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>js</folder>
        <folder>css</folder>
    </media>
    <languages folder="language">
        <language tag="en-GB">en-GB/mod_alfa_search.ini</language>
        <language tag="en-GB">en-GB/mod_alfa_search.sys.ini</language>
    </languages>
    <!--<help
   key="Site_Modules:mod_AlfaSearch" />-->
    <config>
        <fields name="params">
            <fieldset name="basic">

                <field
                        type="number"
                        name="minCharacters"
                        label="MOD_ALFA_SEARCH_MINCHARS_LBL"
                        default="2"
                        min="1"
                        step="1"
                />

                <field
                        name="show_description"
                        type="radio"
                        label="MOD_ALFA_SEARCH_SHOW_DESC_LBL"
                        default="1"
                        layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>


                <field
                        name="description_limit"
                        type="number"
                        label="MOD_ALFA_SEARCH_DESC_LIMIT_LBL"
                        required="false"
                        default="50"
                        min="1"
                        showon="show_description:1"
                />

                <field
                        name="show_categories"
                        type="radio"
                        label="MOD_ALFA_SEARCH_SHOW_CATEGORIES_LBL"
                        default="0"
                        layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                        type="number"
                        name="categories_limit"
                        label="MOD_ALFA_CATEGORIES_LIMIT_LBL"
                        default="6"
                        min="1"
                        step="1"
                        showon="show_categories:1"
                />

                <field
                        name="show_manufacturers"
                        type="radio"
                        label="MOD_ALFA_SHOW_MANUFACTURERS_LBL"
                        default="0"
                        layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                        name="show_suggestions"
                        type="radio"
                        label="MOD_ALFA_SEARCH_SHOW_SUGGESTIONS_LBL"
                        description="MOD_ALFA_SEARCH_SHOW_SUGGESTIONS_DESC"
                        default="1"
                        layout="joomla.form.field.radio.switcher">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                        type="number"
                        name="suggestions_limit"
                        label="MOD_ALFA_SEARCH_SUGGESTIONS_LIMIT_LBL"
                        default="8"
                        min="1"
                        step="1"
                        showon="show_suggestions:1"
                />

                <field
                        type="number"
                        name="manufacturers_limit"
                        label="MOD_ALFA_MANUFACTURERS_LIMIT_LBL"
                        default="6"
                        min="1"
                        step="1"
                        showon="show_manufacturers:1"
                />

                <field
                        name="loadingImageSpacer"
                        type="spacer"
                        label="MOD_ALFA_SEARCH_LOADING_IMAGE_SPACER_LBL"
                />

                <field name="loadingImageType" type="radio" class="btn-group" default="3"
                       label="MOD_ALFA_SEARCH_LOADING_IMAGE_TYPE_LBL"
                       description="MOD_ALFA_SEARCH_LOADING_IMAGE_TYPE_DESC">
                    <option value="0">MOD_ALFA_SEARCH_LOADING_IMAGE_TYPE_IMAGE</option>
                    <option value="1">MOD_ALFA_SEARCH_LOADING_IMAGE_TYPE_SVG</option>
                    <option value="2">MOD_ALFA_SEARCH_LOADING_IMAGE_TYPE_NONE</option>
                    <option value="3">MOD_ALFA_SEARCH_LOADING_IMAGE_TYPE_DEFAULT</option>
                </field>

                <field
                        name="loadingImageFile"
                        type="media"
                        label="MOD_ALFA_SEARCH_LOADING_IMAGE_FILE_LBL"
                        description="MOD_ALFA_SEARCH_LOADING_IMAGE_FILE_DESC"
                        default=""
                        required="false"
                        showon="loadingImageType:0"
                />

                <field
                        name="loadingImageInline"
                        type="textarea"
                        label="MOD_ALFA_SEARCH_LOADING_IMAGE_INLINE_LBL"
                        description="MOD_ALFA_SEARCH_LOADING_IMAGE_INLINE_DESC"
                        filter="raw"
                        showon="loadingImageType:1"
                        rows="5"
                        cols="30"
                />


                <!--                <field-->
                <!--                        name="modify_function"-->
                <!--                        type="radio"-->
                <!--                        class="btn-group"-->
                <!--                        label="COM_ALFA_FORM_LBL_MODIFY_FUNCTION"-->
                <!--                        >-->
                <!--                    <option value="add">Add</option>-->
                <!--                    <option value="remove">Remove</option>-->
                <!--                </field>-->
                <!--   description length -->
            </fieldset>
            <fieldset name="style" label="MOD_ALFA_SEARCH_STYLE_FIELDSET">

                <field type="note" name="style_note"
                       label="MOD_ALFA_SEARCH_STYLE_NOTE"
                       description="MOD_ALFA_SEARCH_STYLE_NOTE_DESC"
                       class="alert alert-info" />

                <field name="style_surface"
                       type="color"
                       format="hex"
                       default=""
                       label="MOD_ALFA_SEARCH_STYLE_SURFACE_LBL"
                       description="MOD_ALFA_SEARCH_STYLE_SURFACE_DESC"
                />

                <field name="style_text"
                       type="color"
                       format="hex"
                       default=""
                       label="MOD_ALFA_SEARCH_STYLE_TEXT_LBL"
                       description="MOD_ALFA_SEARCH_STYLE_TEXT_DESC"
                />

                <field name="style_muted"
                       type="color"
                       format="hex"
                       default=""
                       label="MOD_ALFA_SEARCH_STYLE_MUTED_LBL"
                       description="MOD_ALFA_SEARCH_STYLE_MUTED_DESC"
                />

                <field name="style_muted_dark"
                       type="color"
                       format="hex"
                       default=""
                       label="MOD_ALFA_SEARCH_STYLE_MUTED_DARK_LBL"
                       description="MOD_ALFA_SEARCH_STYLE_MUTED_DARK_DESC"
                />

                <field name="style_text_dark"
                       type="color"
                       format="hex"
                       default=""
                       label="MOD_ALFA_SEARCH_STYLE_TEXT_DARK_LBL"
                       description="MOD_ALFA_SEARCH_STYLE_TEXT_DARK_DESC"
                />

                <field name="style_surface_dark"
                       type="color"
                       format="hex"
                       default=""
                       label="MOD_ALFA_SEARCH_STYLE_SURFACE_DARK_LBL"
                       description="MOD_ALFA_SEARCH_STYLE_SURFACE_DARK_DESC"
                />

                <field name="style_hairline"
                       type="color"
                       format="hex"
                       default=""
                       label="MOD_ALFA_SEARCH_STYLE_HAIRLINE_LBL"
                       description="MOD_ALFA_SEARCH_STYLE_HAIRLINE_DESC"
                />

                <field name="style_hairline_dark"
                       type="color"
                       format="hex"
                       default=""
                       label="MOD_ALFA_SEARCH_STYLE_HAIRLINE_DARK_LBL"
                       description="MOD_ALFA_SEARCH_STYLE_HAIRLINE_DARK_DESC"
                />

                <field name="style_radius"
                       type="number"
                       min="0"
                       max="80"
                       step="1"
                       default=""
                       label="MOD_ALFA_SEARCH_STYLE_RADIUS_LBL"
                       description="MOD_ALFA_SEARCH_STYLE_RADIUS_DESC"
                />
            </fieldset>

            <fieldset name="advanced">
                <field
                        name="layout"
                        type="modulelayout"
                        label="JFIELD_ALT_LAYOUT_LABEL"
                        class="form-select"
                        validate="moduleLayout"
                />

                <field
                        name="moduleclass_sfx"
                        type="textarea"
                        label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                        rows="3"
                        validate="CssIdentifier"
                />

                <field
                        name="cache"
                        type="list"
                        label="COM_MODULES_FIELD_CACHING_LABEL"
                        default="1"
                        filter="integer"
                        validate="options"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                        name="cache_time"
                        type="number"
                        label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                        default="900"
                        filter="integer"
                />

                <field
                        name="cachemode"
                        type="hidden"
                        default="static"
                >
                    <option value="static"></option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>