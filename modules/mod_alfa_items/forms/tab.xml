<?xml version="1.0" encoding="UTF-8"?>
<!-- One tab of mod_alfa_items: what it shows, from which categories, in which order and how
     many - and, in one editor, whatever it sets for itself of the module's Style tab:
     a grid or a slider, its columns or cards per view, its cards - per screen too. -->
<form>
    <fields addfieldprefix="Alfa\Component\Alfa\Administrator\Field">

        <field
                name="label"
                type="text"
                label="MOD_ALFA_ITEMS_TAB_LABEL_LBL"
                description="MOD_ALFA_ITEMS_TAB_LABEL_DESC"
                hint="MOD_ALFA_ITEMS_TAB_LABEL_HINT"
        />

        <field
                name="source"
                type="list"
                default="items"
                label="MOD_ALFA_ITEMS_SOURCE_LBL"
                description="MOD_ALFA_ITEMS_SOURCE_DESC"
                validate="options"
        >
            <option value="items">MOD_ALFA_ITEMS_SOURCE_ITEMS</option>
            <option value="on_sale">MOD_ALFA_ITEMS_SOURCE_ON_SALE</option>
            <option value="best_sellers">MOD_ALFA_ITEMS_SOURCE_BEST_SELLERS</option>
            <option value="recently_viewed">MOD_ALFA_ITEMS_SOURCE_RECENTLY_VIEWED</option>
        </field>

        <field
                name="categories"
                type="categories"
                multiple="true"
                showPath="true"
                layout="joomla.form.field.list-fancy-select"
                label="MOD_ALFA_ITEMS_CATEGORIES_LBL"
                description="MOD_ALFA_ITEMS_CATEGORIES_DESC"
                hint="MOD_ALFA_ITEMS_CATEGORIES_HINT"
        />

        <field
                name="ordering"
                type="list"
                default="a.id DESC"
                label="MOD_ALFA_ITEMS_ORDERING_LBL"
                description="MOD_ALFA_ITEMS_ORDERING_DESC"
                validate="options"
        >
            <option value="a.id DESC">MOD_ALFA_ITEMS_ORDER_NEWEST</option>
            <option value="a.id ASC">MOD_ALFA_ITEMS_ORDER_OLDEST</option>
            <option value="a.ordering ASC">MOD_ALFA_ITEMS_ORDER_CUSTOM_ASC</option>
            <option value="a.ordering DESC">MOD_ALFA_ITEMS_ORDER_CUSTOM_DESC</option>
            <option value="name ASC">MOD_ALFA_ITEMS_ORDER_NAME_ASC</option>
            <option value="name DESC">MOD_ALFA_ITEMS_ORDER_NAME_DESC</option>
            <option value="pf.final_price ASC">MOD_ALFA_ITEMS_ORDER_PRICE_ASC</option>
            <option value="pf.final_price DESC">MOD_ALFA_ITEMS_ORDER_PRICE_DESC</option>
            <option value="pf.discount_amount DESC">MOD_ALFA_ITEMS_ORDER_DISCOUNT_AMOUNT_DESC</option>
            <option value="pf.discount_percent DESC">MOD_ALFA_ITEMS_ORDER_DISCOUNT_PERCENT_DESC</option>
        </field>

        <field
                name="limit"
                type="number"
                default="8"
                min="1"
                max="60"
                step="1"
                filter="integer"
                label="MOD_ALFA_ITEMS_LIMIT_LBL"
                description="MOD_ALFA_ITEMS_LIMIT_DESC"
        />

        <field
                name="show_link"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                default="0"
                label="MOD_ALFA_ITEMS_TAB_LINK_LBL"
                description="MOD_ALFA_ITEMS_TAB_LINK_DESC"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="card" type="cardlook" level="tab" filter="raw" addfieldprefix="Alfa\Module\AlfaItems\Site\Field"
               label="MOD_ALFA_ITEMS_TAB_CARD_LBL"/>
    </fields>
</form>
