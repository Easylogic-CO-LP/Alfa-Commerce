<?xml version="1.0" encoding="utf-8"?>
<metadata>
    <layout title="COM_ALFA_TITLE_ITEM_VIEW_ITEM" option="View">
        <message>
            <![CDATA[COM_ALFA_TITLE_ITEM_VIEW_ITEM_DESC]]>
        </message>
    </layout>
    <fields name="request" addfieldprefix="Alfa\Component\Alfa\Administrator\Field">
        <fieldset
                name="request"
                label="COM_ALFA_FIELDSET_ITEM_ID_SELECT_LABEL">
            <!-- type="model" -> Alfa ModelField (language-resolved item names). -->
            <field
                    name="id"
                    type="model"
                    model="items"
                    column_value="id"
                    column_text="name"
                    label="COM_ALFA_ITEM_ID_SELECT_LABEL"
                    require="true"
                    description="JGLOBAL_SHOW_TITLE_DESC">
            </field>
        </fieldset>
    </fields>

    <fields name="params">
        <fieldset
                name="layouts"
                label="COM_ALFA_MENU_LAYOUTS_OPTIONS"
                addfieldprefix="Alfa\Component\Alfa\Administrator\Field">

            <field
                    name="item_layout"
                    type="viewLayout"
                    view="item"
                    inheritlabel="JGLOBAL_USE_GLOBAL"
                    label="COM_ALFA_LAYOUT_ITEM_LABEL"
                    description="COM_ALFA_LAYOUT_ITEM_DESC"
            />

            <field
                    name="item_images_layout"
                    type="subtemplate"
                    view="item"
                    slot="images"
                    inheritlabel="JGLOBAL_USE_GLOBAL"
                    label="COM_ALFA_LAYOUT_ITEM_IMAGES_LABEL"
            />

            <field
                    name="item_images_grid_columns"
                    type="list"
                    label="COM_ALFA_LAYOUT_IMAGES_GRID_COLUMNS_LABEL"
                    description="COM_ALFA_LAYOUT_IMAGES_GRID_COLUMNS_DESC"
                    validate="options"
            >
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
            </field>

            <field
                    name="item_manufacturers_layout"
                    type="subtemplate"
                    view="item"
                    slot="manufacturers"
                    inheritlabel="JGLOBAL_USE_GLOBAL"
                    label="COM_ALFA_LAYOUT_ITEM_MANUFACTURERS_LABEL"
            />

            <field
                    name="item_categories_layout"
                    type="subtemplate"
                    view="item"
                    slot="categories"
                    inheritlabel="JGLOBAL_USE_GLOBAL"
                    label="COM_ALFA_LAYOUT_ITEM_CATEGORIES_LABEL"
            />

            <field
                    name="item_sections"
                    type="list"
                    label="COM_ALFA_LAYOUT_ITEM_SECTIONS"
                    description="COM_ALFA_LAYOUT_ITEM_SECTIONS_DESC"
                    validate="options"
            >
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="stacked">COM_ALFA_LAYOUT_ITEM_SECTIONS_STACKED</option>
                <option value="tabs">COM_ALFA_LAYOUT_ITEM_SECTIONS_TABS</option>
                <option value="accordion">COM_ALFA_LAYOUT_ITEM_SECTIONS_ACCORDION</option>
            </field>

            <field
                    name="item_methods"
                    type="list"
                    label="COM_ALFA_LAYOUT_ITEM_METHODS"
                    description="COM_ALFA_LAYOUT_ITEM_METHODS_DESC"
                    validate="options"
            >
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="frame">COM_ALFA_LAYOUT_ITEM_METHODS_FRAME</option>
                <option value="hidden">COM_ALFA_LAYOUT_ITEM_METHODS_HIDDEN</option>
            </field>

            <field
                    name="item_related_layout"
                    type="subtemplate"
                    view="item"
                    slot="related"
                    inheritlabel="JGLOBAL_USE_GLOBAL"
                    label="COM_ALFA_LAYOUT_ITEM_RELATED_LABEL"
            />

            <field
                    name="item_related_count"
                    type="list"
                    label="COM_ALFA_LAYOUT_RELATED_COUNT_LABEL"
                    description="COM_ALFA_LAYOUT_RELATED_COUNT_DESC"
                    validate="options"
            >
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="0">0</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
                <option value="6">6</option>
                <option value="7">7</option>
                <option value="8">8</option>
                <option value="9">9</option>
                <option value="10">10</option>
                <option value="11">11</option>
                <option value="12">12</option>
            </field>
        </fieldset>
    </fields>
</metadata>
